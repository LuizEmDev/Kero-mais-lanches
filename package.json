{
  "name": "kero-mais",
  "version": "1.0.0",
  "private": true,
  "description": "Kero+ lanches: site, cardápio, pedidos na mesa e entrega, Pix, cozinha e dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "build:pages": "vite build --config vite.pages.config.js && cp dist-pages/index.html dist-pages/404.html && touch dist-pages/.nojekyll"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/bagel-fat-one": "^5.3.0",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.8"
  }
}
