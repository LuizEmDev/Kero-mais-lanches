# Porta do servidor
PORT=3000

# PIN de acesso da equipe (cozinha e painel). TROQUE antes de usar de verdade.
STAFF_PIN=1234

# Segredo para assinar a sessão da equipe (opcional: se vazio, é gerado e guardado no banco)
SESSION_SECRET=

# Modo demonstração: botão "Simular pagamento" e histórico fictício no dashboard.
# Desligue em produção.
DEMO_MODE=true

# Arquivo do banco SQLite
DB_FILE=data/kero.db

# ---- Pix por chave (funciona com qualquer banco; a equipe confirma o pagamento no painel)
PIX_KEY=
PIX_MERCHANT_NAME=KERO MAIS LANCHES
PIX_MERCHANT_CITY=SAO PAULO

# ---- Pix com confirmação automática (Mercado Pago)
# Com o token preenchido, cada cobrança vira um Pix dinâmico e o webhook confirma sozinho.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# E-mail usado como pagador quando o cliente não informa um (exigido pelo Mercado Pago)
MP_PAYER_EMAIL=
# Endereço público https do site, para o Mercado Pago chamar o webhook
PUBLIC_URL=
